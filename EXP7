# ============================================================
# EXPERIMENT:
# K-Means Clustering and PCA on Pima Indians Diabetes Dataset
# ============================================================


# ============================================================
# 1. IMPORT REQUIRED LIBRARIES
# ============================================================

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans
from sklearn.metrics import silhouette_score
from sklearn.decomposition import PCA


# ============================================================
# 2. LOAD THE DATASET
# ============================================================

url = "https://raw.githubusercontent.com/jbrownlee/Datasets/master/pima-indians-diabetes.data.csv"

columns = [
    "Pregnancies",
    "Glucose",
    "BloodPressure",
    "SkinThickness",
    "Insulin",
    "BMI",
    "DiabetesPedigreeFunction",
    "Age",
    "Outcome"
]

df = pd.read_csv(url, names=columns)


# Display first 5 rows
print("First 5 rows:")
print(df.head())


# Display dataset shape
print("\nDataset Shape:")
print(df.shape)


# ============================================================
# 3. DATASET INFORMATION
# ============================================================

print("\nDataset Information:")
df.info()


# Statistical summary
print("\nStatistical Summary:")
print(df.describe())


# ============================================================
# 4. CHECK MISSING VALUES
# ============================================================

print("\nMissing Values:")
print(df.isnull().sum())


# ============================================================
# 5. HANDLE INVALID VALUES
# ============================================================

# In the Pima dataset, zero values in these medical
# features are considered invalid/missing values.

invalid_columns = [
    "Glucose",
    "BloodPressure",
    "SkinThickness",
    "Insulin",
    "BMI"
]


# Replace zero values with NaN
df[invalid_columns] = df[invalid_columns].replace(0, np.nan)


print("\nMissing Values After Replacing Invalid Zeros:")
print(df.isnull().sum())


# ============================================================
# 6. FILL MISSING VALUES
# ============================================================

# Replace missing values with the median of each column

for column in invalid_columns:
    df[column] = df[column].fillna(df[column].median())


print("\nMissing Values After Median Imputation:")
print(df.isnull().sum())


# ============================================================
# 7. SELECT FEATURES FOR UNSUPERVISED LEARNING
# ============================================================

# Outcome is excluded because K-Means is an
# unsupervised learning algorithm.

features = [
    "Pregnancies",
    "Glucose",
    "BloodPressure",
    "SkinThickness",
    "Insulin",
    "BMI",
    "DiabetesPedigreeFunction",
    "Age"
]

X = df[features]


print("\nSelected Features:")
print(X.head())


# ============================================================
# 8. STANDARDIZE THE FEATURES
# ============================================================

scaler = StandardScaler()

X_scaled = scaler.fit_transform(X)


print("\nStandardized Data:")
print(X_scaled[:5])


# Convert standardized data into DataFrame
X_scaled_df = pd.DataFrame(
    X_scaled,
    columns=features
)


print("\nStandardized Data Summary:")
print(X_scaled_df.describe())


# ============================================================
# 9. ELBOW METHOD
# ============================================================

inertia = []

# Test K values from 2 to 10
K_values = range(2, 11)


for k in K_values:

    kmeans = KMeans(
        n_clusters=k,
        random_state=42,
        n_init=10
    )

    kmeans.fit(X_scaled)

    # IMPORTANT:
    # Correct attribute is inertia_
    # NOT inertia__
    inertia.append(kmeans.inertia_)


# ============================================================
# 10. PLOT ELBOW CURVE
# ============================================================

plt.figure(figsize=(8, 5))

plt.plot(
    K_values,
    inertia,
    marker="o"
)

plt.xlabel("Number of Clusters (K)")
plt.ylabel("Inertia / Within-Cluster Sum of Squares")

plt.title("Elbow Method for Optimal K")

plt.xticks(K_values)

plt.grid(True)

plt.show()


# ============================================================
# 11. SELECT NUMBER OF CLUSTERS
# ============================================================

# Based on the Elbow Method.
# You can change this value after observing the graph.

optimal_k = 3


print("\nSelected Number of Clusters:", optimal_k)


# ============================================================
# 12. APPLY K-MEANS CLUSTERING
# ============================================================

kmeans = KMeans(
    n_clusters=optimal_k,
    random_state=42,
    n_init=10
)


# Perform clustering
cluster_labels = kmeans.fit_predict(X_scaled)


# Add cluster labels to dataset
df["Cluster"] = cluster_labels


print("\nCluster Assignments:")
print(df[features + ["Cluster"]].head(10))


# ============================================================
# 13. DISPLAY CLUSTER SIZES
# ============================================================

print("\nNumber of Patients in Each Cluster:")

print(
    df["Cluster"]
    .value_counts()
    .sort_index()
)


# ============================================================
# 14. SILHOUETTE SCORE
# ============================================================

sil_score = silhouette_score(
    X_scaled,
    cluster_labels
)


print("\nSilhouette Score:")
print(round(sil_score, 4))


# ============================================================
# 15. SILHOUETTE SCORES FOR DIFFERENT K VALUES
# ============================================================

silhouette_scores = []


for k in range(2, 11):

    kmeans_temp = KMeans(
        n_clusters=k,
        random_state=42,
        n_init=10
    )

    labels_temp = kmeans_temp.fit_predict(X_scaled)

    score = silhouette_score(
        X_scaled,
        labels_temp
    )

    silhouette_scores.append(score)


# Display silhouette scores

print("\nSilhouette Scores for Different K Values:")

for k, score in zip(
    range(2, 11),
    silhouette_scores
):

    print(
        "K =", k,
        "Silhouette Score =",
        round(score, 4)
    )


# ============================================================
# 16. PLOT SILHOUETTE SCORES
# ============================================================

plt.figure(figsize=(8, 5))

plt.plot(
    range(2, 11),
    silhouette_scores,
    marker="o"
)

plt.xlabel("Number of Clusters (K)")

plt.ylabel("Silhouette Score")

plt.title("Silhouette Score for Different K Values")

plt.xticks(range(2, 11))

plt.grid(True)

plt.show()


# ============================================================
# 17. APPLY PCA
# ============================================================

# Reduce 8 dimensions to 2 dimensions

pca = PCA(
    n_components=2
)


X_pca = pca.fit_transform(X_scaled)


print("\nPCA Data Shape:")
print(X_pca.shape)


# ============================================================
# 18. PCA EXPLAINED VARIANCE
# ============================================================

explained_variance = pca.explained_variance_ratio_


print("\nExplained Variance Ratio:")

print(explained_variance)


total_variance = (
    sum(explained_variance) * 100
)


print(
    "\nTotal Variance Explained by PC1 and PC2:",
    round(total_variance, 2),
    "%"
)


# ============================================================
# 19. CREATE PCA DATAFRAME
# ============================================================

pca_df = pd.DataFrame(
    X_pca,
    columns=["PC1", "PC2"]
)


# Add cluster information
pca_df["Cluster"] = cluster_labels


# Add actual diabetes outcome only for comparison
pca_df["Outcome"] = df["Outcome"]


print("\nPCA Data:")
print(pca_df.head())


# ============================================================
# 20. VISUALIZE K-MEANS CLUSTERS USING PCA
# ============================================================

plt.figure(figsize=(9, 6))

sns.scatterplot(
    data=pca_df,
    x="PC1",
    y="PC2",
    hue="Cluster",
    palette="Set1",
    s=70
)

plt.title(
    "K-Means Clusters Visualized Using PCA"
)

plt.xlabel("Principal Component 1")

plt.ylabel("Principal Component 2")

plt.grid(True)

plt.show()


# ============================================================
# 21. VISUALIZE ACTUAL DIABETES OUTCOME USING PCA
# ============================================================

plt.figure(figsize=(9, 6))

sns.scatterplot(
    data=pca_df,
    x="PC1",
    y="PC2",
    hue="Outcome",
    palette="Set2",
    s=70
)

plt.title(
    "PCA Visualization Based on Actual Diabetes Outcome"
)

plt.xlabel("Principal Component 1")

plt.ylabel("Principal Component 2")

plt.grid(True)

plt.show()


# ============================================================
# 22. COMPARE CLUSTERS WITH ACTUAL OUTCOME
# ============================================================

cluster_outcome_table = pd.crosstab(
    df["Cluster"],
    df["Outcome"]
)


print("\nCluster vs Actual Diabetes Outcome:")

print(cluster_outcome_table)


# ============================================================
# 23. CALCULATE CLUSTER-WISE MEAN VALUES
# ============================================================

cluster_means = df.groupby(
    "Cluster"
)[features].mean()


print("\nAverage Feature Values for Each Cluster:")

print(
    cluster_means.round(2)
)


# ============================================================
# 24. HEATMAP OF CLUSTER MEANS
# ============================================================

plt.figure(figsize=(12, 6))

sns.heatmap(
    cluster_means,
    annot=True,
    fmt=".2f",
    cmap="coolwarm"
)

plt.title(
    "Cluster-wise Mean Feature Values"
)

plt.xlabel("Features")

plt.ylabel("Cluster")

plt.show()


# ============================================================
# 25. FINAL RESULTS
# ============================================================

print("\n")
print("==============================================")
print("             FINAL RESULTS")
print("==============================================")


print(
    "\nDataset Size:",
    df.shape
)


print(
    "Number of Clusters:",
    optimal_k
)


print(
    "Silhouette Score:",
    round(sil_score, 4)
)


print(
    "Variance Explained by PCA:",
    round(total_variance, 2),
    "%"
)


print("\nCluster Sizes:")

print(
    df["Cluster"]
    .value_counts()
    .sort_index()
)


print("\nCluster vs Outcome:")

print(cluster_outcome_table)


print("\n==============================================")
print("       EXPERIMENT COMPLETED SUCCESSFULLY")
print("==============================================")
